# Variables públicas del build de producción (next build las incrusta en el JS).
# Sin NEXT_PUBLIC_SKIPPER_API_URL el registro cae en http://localhost:8080 y el
# navegador muestra "Failed to fetch" (oct-2026). No poner secretos aquí.
NEXT_PUBLIC_SKIPPER_API_URL=https://skippermx.com
NEXT_PUBLIC_SITE_URL=https://totalclaimassist.com
NEXT_PUBLIC_TOTALASSIST_APP_URL=https://totalclaimassist.app
